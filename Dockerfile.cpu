# Prediction image for the distributed TensorFlow 2.10 / Keras 2 model.
FROM python:3.10.22-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370

LABEL org.opencontainers.image.source="https://github.com/uedaLabR/rnaModScan" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.description="rnaModScan CPU prediction runtime"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    CUDA_VISIBLE_DEVICES=-1

RUN test "$(dpkg --print-architecture)" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/rnaModScan
COPY docker/requirements-runtime.txt docker/requirements-runtime.txt
RUN python -m pip install pip==25.3 setuptools==80.9.0 wheel==0.45.1 \
    && python -m pip install tensorflow-cpu==2.10.1 -r docker/requirements-runtime.txt

# .dockerignore also restricts the context to these public runtime dependencies.
COPY pyproject.toml LICENSE README.md ./
COPY rnamodscan/ rnamodscan/
COPY prediction/ prediction/
COPY utils/ utils/
COPY docker/ docker/
COPY models/pooled_HEK293T_HeLa_20261111/ models/pooled_HEK293T_HeLa_20261111/
COPY data/references/hg38/ data/references/hg38/
RUN python -m pip install --no-deps --no-build-isolation -e . \
    && python -m pip check \
    && python docker/smoke_test.py --device cpu \
    && chmod -R a+rX /opt/rnaModScan \
    && useradd --create-home --uid 10001 rnamodscan \
    && mkdir /work \
    && chown rnamodscan:rnamodscan /work

WORKDIR /work
USER 10001:10001
ENTRYPOINT ["rnamodscan"]
CMD ["--help"]
